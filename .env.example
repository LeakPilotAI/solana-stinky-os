# Stinky OS â€“ local development
# Ports chosen to avoid conflict with Atlas (5432 / 6379 / 8000)
# Copy to .env and adjust if needed

STINKY_ENVIRONMENT=development
STINKY_LOG_LEVEL=INFO

# PostgreSQL (TimescaleDB) â€“ host port 5433
STINKY_DATABASE_URL=postgresql+asyncpg://stinky:stinky@localhost:5433/stinky

# Redis â€“ host port 6380
STINKY_REDIS_URL=redis://localhost:6380/0
STINKY_EVENT_STREAM=stinky.events
STINKY_CONSUMER_GROUP=event-log

# Object storage (MinIO) â€“ host ports 9010 / 9011
STINKY_OBJECT_STORAGE_ENDPOINT=http://localhost:9010
STINKY_OBJECT_STORAGE_ACCESS_KEY=minioadmin
STINKY_OBJECT_STORAGE_SECRET_KEY=minioadmin
STINKY_OBJECT_STORAGE_BUCKET=stinky

# Service ports â€“ use 8002 (Atlas 8000; avoid other bots on 8001)
STINKY_EVENT_LOG_PORT=8002
STINKY_EVENT_LOG_URL=http://localhost:8002
STINKY_METRICS_PORT=9101

# Solana (Sentinel)
STINKY_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STINKY_SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# STINKY_HELIUS_API_KEY=your_helius_key_here

# Volume gate (post-migration alerts)
STINKY_VOLUME_THRESHOLD_USD=25000
STINKY_VOLUME_POLL_INTERVAL_SEC=20
STINKY_VOLUME_MAX_WATCH_SEC=900

# Discord bot
STINKY_DISCORD_TOKEN=
STINKY_DISCORD_GUILD_ID=
STINKY_DISCORD_ALERT_CHANNEL_ID=

# Post-Migration Intelligence Collector
STINKY_MAX_EARLY_BUYERS=20
STINKY_MIN_MEANINGFUL_SOL=0.01
STINKY_TRACK_POLL_INTERVAL_SEC=30
STINKY_TRACK_MAX_DURATION_SEC=3600
STINKY_MARKET_SNAPSHOT_INTERVAL_SEC=60
STINKY_MAX_CONCURRENT_TRACKS=50
STINKY_MILESTONE_MULTIPLES=2,5,10,50,100

# Pump-only quality (anti synthetic / non-pump DEXes)
STINKY_ALLOWED_DEX_IDS=pumpswap,pumpfun,pump
STINKY_DENIED_DEX_IDS=meteora,raydium,orca,phoenix,lifinity,saber,aldrin,fluxbeam
STINKY_REQUIRE_PUMP_MINT_SUFFIX=true
# HARD GATE: verified pump.fun global fees paid (SOL). Fail-closed. Unknown or < 3.0 â†’ reject.
STINKY_MIN_FEES_SOL=5.0

# axiom-parity-v1.0.0 full opportunity screen (FilterEngine)
STINKY_FILTER_VERSION=axiom-parity-v1.0.0
STINKY_MIN_LIQUIDITY_USD=8
STINKY_MIN_VOLUME_USD=100000
STINKY_MIN_MARKET_CAP_USD=31333
STINKY_REQUIRE_AT_LEAST_ONE_SOCIAL=true
BIRDEYE_API_KEY=
STINKY_BIRDEYE_API_KEY=


